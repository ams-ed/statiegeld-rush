# OS & local tooling
.DS_Store
node_modules/

# Secrets & API keys (never commit)
.env
.env.*
*.key
*.pem
*fal_key*

# Raw uncut local Playwright recording (176 MB)
/playtest_take.mp4

# Ignore intermediate/duplicate fal generation outputs in assets/,
